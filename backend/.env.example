# ==============================================================================
# SunPower Solutions — Solar Installation Management System Backend
# Environment Configuration Template
# ==============================================================================

# Application Settings
PROJECT_NAME="SunPower Solutions API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Security & JWT
# IMPORTANT: Generate a secure 32-byte secret key in production (e.g. `openssl rand -hex 32`)
SECRET_KEY="sunpower-super-secret-key-change-in-production-min-32-chars-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings (PostgreSQL)
# Async driver: asyncpg (used by FastAPI backend)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/sunpower_db"
# Synchronous driver: psycopg2 (used by Alembic for migrations)
SYNC_DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/sunpower_db"
# Test database
TEST_DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/sunpower_test_db"

# CORS Configuration (JSON array of allowed origins for React/Frontend)
ALLOWED_ORIGINS='["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]'

# File Upload Settings
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10

# OTP Settings
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=3

